rules_version = '2';

// Quy tắc bảo mật cho tính năng "Phòng họp xem chung".
// - Chỉ người đã đăng nhập ẩn danh (Firebase Anonymous Auth) mới đọc/ghi.
// - Không ai liệt kê được danh sách phòng; phải biết mã phòng (20 ký tự ngẫu nhiên) mới đọc được.
// - Chỉ chủ phòng (hostUid) được ghi tin nhắn, bản dịch và đóng phòng.
// - Mọi quyền đọc/ghi chấm dứt khi phòng hết hạn (expiresAt).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roomData(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
    function isHost(roomId) { return signedIn() && roomData(roomId).hostUid == request.auth.uid; }
    function isCohost(roomId) { return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/cohosts/$(request.auth.uid)); }
    function alive(roomId) { return request.time < roomData(roomId).expiresAt; }

    match /rooms/{roomId} {
      allow get: if signedIn() && request.time < resource.data.expiresAt;
      allow list: if false;

      allow create: if signedIn()
        && roomId.size() >= 16
        && request.resource.data.keys().hasOnly(['hostUid', 'createdAt', 'expiresAt', 'status', 'hostSrc', 'hostTgt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(1, 'h')
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');

      // Chủ phòng chỉ được đóng phòng hoặc rút ngắn thời hạn, không được kéo dài
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expiresAt', 'hostSrc', 'hostTgt'])
        && request.resource.data.expiresAt <= resource.data.expiresAt;

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /messages/{messageId} {
        allow get, list: if signedIn() && alive(roomId);

        // Chủ phòng và máy thứ hai (đã nhập đúng mã mời) được ghi tin nhắn
        allow create: if (isHost(roomId) || isCohost(roomId)) && alive(roomId)
          && request.resource.data.keys().hasOnly(['src', 'out', 'from', 'to', 'ts', 'meeting', 'expiresAt', 'tr', 'utt', 'by'])
          && request.resource.data.src is string && request.resource.data.src.size() <= 6000
          && request.resource.data.out is string && request.resource.data.out.size() <= 8000;

        // Chỉ được thêm bản dịch (trường tr), không sửa nội dung đã ghi
        allow update: if isHost(roomId) && alive(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tr']);

        allow delete: if isHost(roomId);
      }

      // Bản "đang nói": một tài liệu duy nhất (live/now), chủ phòng ghi đè liên tục
      match /live/{docId} {
        allow get: if signedIn() && alive(roomId);
        allow create, update: if alive(roomId)
          && ((docId == 'now' && isHost(roomId)) || (docId == 'co' && isCohost(roomId)))
          && request.resource.data.keys().hasOnly(['utt', 'src', 'out', 'from', 'to', 'ts', 'expiresAt'])
          && request.resource.data.src is string && request.resource.data.src.size() <= 6000
          && request.resource.data.out is string && request.resource.data.out.size() <= 8000;
        allow delete: if isHost(roomId);
      }

      // Mã mời máy thứ hai: chỉ chủ phòng đọc/ghi; quy tắc cohosts đối chiếu mã này
      match /secret/{docId} {
        allow get, delete: if isHost(roomId) && docId == 'code';
        allow create: if isHost(roomId) && docId == 'code'
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code is string && request.resource.data.code.size() >= 16 && request.resource.data.code.size() <= 64;
      }

      // Máy thứ hai: tự ghi danh bằng đúng mã mời của chủ phòng
      match /cohosts/{cohostUid} {
        allow create, update: if signedIn() && request.auth.uid == cohostUid && alive(roomId)
          && request.resource.data.keys().hasOnly(['code', 'ts', 'expiresAt'])
          && request.resource.data.code is string
          && request.resource.data.code == get(/databases/$(database)/documents/rooms/$(roomId)/secret/code).data.code;
        allow get: if signedIn() && (request.auth.uid == cohostUid || isHost(roomId));
        allow list: if isHost(roomId);
        allow delete: if signedIn() && (request.auth.uid == cohostUid || isHost(roomId));
      }

      match /viewers/{viewerUid} {
        allow create, update: if signedIn() && request.auth.uid == viewerUid && alive(roomId)
          && request.resource.data.keys().hasOnly(['lang', 'ts', 'expiresAt'])
          && request.resource.data.lang is string && request.resource.data.lang.size() <= 4;
        allow get, list: if isHost(roomId) || (signedIn() && request.auth.uid == viewerUid);
        allow delete: if signedIn() && (request.auth.uid == viewerUid || isHost(roomId));
      }
    }

    // ---------- Tài khoản VIP ----------
    // - Người dùng tự đăng ký bằng email + mật khẩu (Firebase Authentication); hồ sơ users/{uid} luôn bắt đầu ở trạng thái "pending".
    // - Chỉ quản trị viên (có tài liệu admins/{uid}) mới đổi được trạng thái và hạn dùng; người dùng không tự cấp quyền cho mình.
    // - Khóa Google dùng chung (config/google) chỉ trả về cho quản trị viên hoặc VIP đang "active" và còn hạn (expiresAt).
    // - tài liệu admins/{uid} KHÔNG ghi được từ ứng dụng: chỉ tạo thủ công trong Firebase Console.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function realUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function vipActive() {
      return realUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().status == 'active'
        && myProfile().expiresAt > request.time;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Tự đăng ký: chỉ tạo hồ sơ của chính mình, trạng thái chờ duyệt, email trùng email đăng nhập
      allow create: if realUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'status', 'requestedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email is string && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.requestedAt is number;

      allow update: if
        // người dùng: chỉ đổi tên, số liệu sử dụng tự báo và lần dùng gần nhất
        (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'usage', 'lastSeen'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 100)
        // quản trị viên: duyệt, gia hạn, khóa
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expiresAt', 'plan', 'note', 'approvedAt', 'approvedBy'])
          && request.resource.data.status in ['pending', 'active', 'blocked']);

      allow delete: if isAdmin();
    }

    match /config/{docId} {
      // google: khóa dùng chung + hạn mức tổng + giới hạn mỗi tài khoản VIP (VIP còn hạn cần đọc để tự áp dụng)
      allow get: if docId == 'google' && (isAdmin() || vipActive());
      // billing: thông tin gói/ngân sách Google Cloud của chủ dự án, chỉ quản trị viên đọc và ghi
      allow get: if docId == 'billing' && isAdmin();
      allow list: if false;
      allow create, update: if docId == 'google' && isAdmin()
        && request.resource.data.keys().hasOnly(['key', 'trLimit', 'ttsLimit', 'userTr', 'userTts', 'updatedAt'])
        && request.resource.data.key is string && request.resource.data.key.size() <= 200
        && request.resource.data.trLimit is number && request.resource.data.ttsLimit is number
        && request.resource.data.get('userTr', 0) is number && request.resource.data.get('userTts', 0) is number;
      allow create, update: if docId == 'billing' && isAdmin()
        && request.resource.data.keys().hasOnly(['creditUsd', 'vndPerUsd', 'trialEndMs', 'trPrice', 'ttsPrice', 'ttsFree', 'updatedAt'])
        && request.resource.data.get('creditUsd', 0) is number && request.resource.data.get('vndPerUsd', 0) is number
        && request.resource.data.get('trialEndMs', 0) is number && request.resource.data.get('trPrice', 0) is number
        && request.resource.data.get('ttsPrice', 0) is number && request.resource.data.get('ttsFree', 0) is number;
      allow delete: if false;
    }
  }
}
